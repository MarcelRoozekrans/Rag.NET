<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- WireMockServerFixture's record path is only observable by driving it against a stub
         upstream and reading what lands on disk; LoadCassettesFrom is the seam that allows it. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.DataProviders.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" />
    <!-- Direct only to lift SSH.NET past GHSA-q939-rpr3-3284: Testcontainers 4.13.0 pins the vulnerable 2025.1.0 and has no newer release. Nothing in src/ pulls it, so no shipped package is affected. -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Ollama" />
    <PackageReference Include="WireMock.Net" />
    <!-- Audit lifts: WireMock.Net pins Scriban.Signed 5.5.0 (multiple advisories, patched in 7.0.0);
         the AI/testing chain pins OpenTelemetry 1.14.0 (advisories patched in 1.15.3). -->
    <PackageReference Include="Scriban.Signed" />
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <!-- No stable release exists yet for Microsoft.Extensions.AI.Ollama; pinned to latest preview. Update when stable is released. -->
    <PackageReference Include="Microsoft.Extensions.AI.Ollama" />
  </ItemGroup>

  <ItemGroup>
    <!-- The "Rag.NET"-named ActivitySource core and every instrumented satellite link; see
         src/Shared/RagTelemetrySource.cs. Linked here (a second, independently-compiled copy)
         purely so TelemetryProbe can hand RagTelemetrySourceCrossAssemblyTests a genuine
         second assembly's instance without a ProjectReference to core — this project already
         plays that "reachable from Rag.NET.Tests but not core" role for other fixtures. -->
    <Compile Include="..\..\src\Shared\RagTelemetrySource.cs" Link="Telemetry\RagTelemetrySource.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rag.NET.Abstractions\Rag.NET.Abstractions.csproj" />
  </ItemGroup>

</Project>
