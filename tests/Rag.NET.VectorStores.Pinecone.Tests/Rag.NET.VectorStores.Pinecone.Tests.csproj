<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Starts a Testcontainers container. CI runs these in the Docker tier, which is
         Linux-only: the Windows runners have no Linux Docker daemon. -->
    <RequiresDocker>true</RequiresDocker>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rag.NET.VectorStores.Pinecone\Rag.NET.VectorStores.Pinecone.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET\Rag.NET.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Testcontainers" />
    <!-- Direct only to lift SSH.NET past GHSA-q939-rpr3-3284: Testcontainers 4.13.0 pins the vulnerable 2025.1.0 and has no newer release. Nothing in src/ pulls it, so no shipped package is affected. -->
    <PackageReference Include="SSH.NET" />
  </ItemGroup>

</Project>
