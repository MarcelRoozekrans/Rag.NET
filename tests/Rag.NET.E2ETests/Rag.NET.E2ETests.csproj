<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Starts a Testcontainers container, via Rag.NET.Testing's OllamaFixture rather than a
         Testcontainers reference of its own. CI runs these in the Docker tier, which is
         Linux-only: the Windows runners have no Linux Docker daemon. -->
    <RequiresDocker>true</RequiresDocker>
    <!-- Pulls nomic-embed-text and llama3.2:1b — about 2 GB per run — and its assertions are
         model output, measured at roughly 1 failure in 11 runs in Phase 2.1. Nightly and opt-in,
         never a required check. -->
    <RequiresLlm>true</RequiresLlm>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rag.NET\Rag.NET.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.AnswerEngines\Rag.NET.AnswerEngines.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.Graph\Rag.NET.Graph.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.GraphRag\Rag.NET.GraphRag.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.VectorStores.PgVector\Rag.NET.VectorStores.PgVector.csproj" />
    <ProjectReference Include="..\Rag.NET.Testing\Rag.NET.Testing.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" />
  </ItemGroup>

</Project>
