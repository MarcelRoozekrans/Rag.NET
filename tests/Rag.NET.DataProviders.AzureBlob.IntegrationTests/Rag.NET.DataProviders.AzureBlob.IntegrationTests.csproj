<Project Sdk="Microsoft.NET.Sdk">

  <!-- Starts an Azurite container via Testcontainers. CI runs these in the Docker tier, which is
       Linux-only by design — the same declaration the vector-store container suites carry.
       Separate from Rag.NET.DataProviders.AzureBlob.Tests so that project stays in the fast tier:
       a stale or missing tier declaration fails Rag.NET.RepoConventions.Tests either way. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RequiresDocker>true</RequiresDocker>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rag.NET.DataProviders.AzureBlob\Rag.NET.DataProviders.AzureBlob.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers" />
    <!-- Direct only to lift SSH.NET past GHSA-q939-rpr3-3284: Testcontainers 4.13.0 pins the vulnerable 2025.1.0 and has no newer release. Nothing in src/ pulls it, so no shipped package is affected. -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
