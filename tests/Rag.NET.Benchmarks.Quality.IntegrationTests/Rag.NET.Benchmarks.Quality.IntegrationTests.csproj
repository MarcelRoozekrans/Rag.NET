<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- A project of its own rather than a file in Rag.NET.Benchmarks.Quality.Tests, and the split
         is the whole point. BeirParityTests reads RAGNET_ONNX_EMBED_MODEL,
         RAGNET_ONNX_EMBED_VOCAB and RAGNET_BEIR_CACHE, so RepoConventions requires
         <RequiresSecrets>true</RequiresSecrets> — and that property is declared per PROJECT, not
         per test. Putting the parity test next to the metric and loader unit tests would carry all
         70 of them out of ci.yml's fast gating tier and into nightly.yml's advisory job, where a
         wrong nDCG stops failing pull requests. Task 4 kept the RAGNET_BEIR_CACHE read in
         src/Rag.NET.Benchmarks.Quality for exactly that reason; this project is the other half of
         the same decision.

         So: the arithmetic gates on every push, and the one test that needs an 86 MB model, a
         downloaded corpus and several minutes of CPU runs nightly. -->
    <RequiresSecrets>true</RequiresSecrets>

    <!-- Routes `dotnet test` through xunit v3's own in-process runner (Microsoft.Testing
         Platform) instead of the VSTest adapter, for #275.

         The adapter deadlocked 2 of 4 runs of BeirGraphRagAnswerTests on one machine, before any
         test code was entered. A minidump showed VsTestRunner.RunTests blocked on
         WaitHandle.WaitOne, the host's main thread blocked on the task representing it, and no
         Rag.NET frame on any thread. The native runner ran the same workload for over an hour,
         sustaining ~56% CPU with RSS climbing 273 MB to 1.4 GB, where `dotnet test` never got past
         68 MB and 1 s of CPU.

         Per project rather than repo wide on purpose: ci.yml invokes `dotnet test` once per
         project, so this changes how one project runs and leaves the other sixty-odd on the adapter
         they work fine under. Microsoft.NET.Test.Sdk stays referenced because both workflows SELECT
         projects by grepping for it, and removing it would quietly drop this project from CI
         entirely. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- The GraphRAG extraction generation tool, referenced for its ingestion driver rather than
         for its entry point. The extraction cache is keyed on the rendered prompt, so if this
         guard chunked or prompted even slightly differently from the run that filled the cache,
         every key would miss and the failure would look exactly like an empty cache. One
         GraphRagSliceIngestion, driven by both, makes that impossible — the same reasoning that
         has the parity and real runs share BeirHarness. -->
    <ProjectReference Include="..\..\benchmarks\Rag.NET.Benchmarks.Quality.GraphExtractions\Rag.NET.Benchmarks.Quality.GraphExtractions.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.Benchmarks.Quality\Rag.NET.Benchmarks.Quality.csproj" />
    <!-- RagTelemetrySource is NOT linked into this project, unlike every other instrumented
         assembly (see src/Shared/RagTelemetrySource.cs). This ProjectReference to
         Rag.NET.GraphRag already brings its own linked copy into scope, made visible here by the
         InternalsVisibleTo grant on Rag.NET.GraphRag.csproj. Linking a second copy on top of that
         visibility makes `Rag.NET.Telemetry.RagTelemetrySource` ambiguous between the two
         candidates and fails to build (CS0436) — exactly the "ambiguity note" in
         RagTelemetrySource.cs's own remarks. The fixture in LegacyPageRankLocalSearch.cs starts
         an activity through Rag.NET.GraphRag's instance, not one of its own. -->
    <ProjectReference Include="..\..\src\Rag.NET.GraphRag\Rag.NET.GraphRag.csproj" />
    <!-- SemanticChunkingStrategy, for the SemanticChunking ablation cell: it is the only cell
         that changes what a unit is rather than how units are ranked. -->
    <ProjectReference Include="..\..\src\Rag.NET.Chunking\Rag.NET.Chunking.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.Embeddings.Onnx\Rag.NET.Embeddings.Onnx.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.Reranking.Onnx\Rag.NET.Reranking.Onnx.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.Raptor\Rag.NET.Raptor.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.Raptor.Store\Rag.NET.Raptor.Store.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET\Rag.NET.csproj" />
    <!-- MapReduceAnswerEngine, RefineAnswerEngine, FlareAnswerEngine and
         SelfAssessmentConfidenceScorer live here (namespace Rag.NET.AnswerGeneration, same as
         ChatAnswerEngine in Rag.NET.csproj above) — needed by the AnswerEngineArms factory. No
         other referenced project brings this one in transitively. -->
    <ProjectReference Include="..\..\src\Rag.NET.AnswerEngines\Rag.NET.AnswerEngines.csproj" />
    <!-- The Phase 3.14 Semantic Kernel entrant's pins, exactly as
         docs/reference/library-comparison-defaults.md records them (read 2026-08-02, before the
         entrant was written): Microsoft.SemanticKernel 1.78.0 is the latest stable and the version
         the row is measured at; its retrieval path lives in the InMemory connector, which has
         NEVER shipped a stable version (1.74.0-preview is the latest of any kind), plus
         Microsoft.Extensions.VectorData.Abstractions 10.1.0 — the version SK 1.78.0 itself pins.
         Exact versions, no wildcards: a comparison row measured at a floating version is a row
         nobody can reproduce. -->
    <PackageReference Include="Microsoft.SemanticKernel" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.InMemory" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- LegacyPageRankLocalSearchTests substitutes IGraphStore, as GraphLocalSearchBehaviorTests
         did before the move. -->
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

</Project>
