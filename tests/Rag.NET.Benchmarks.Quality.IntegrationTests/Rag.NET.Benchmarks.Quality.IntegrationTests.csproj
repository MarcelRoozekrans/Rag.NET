<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- A project of its own rather than a file in Rag.NET.Benchmarks.Quality.Tests, and the split
         is the whole point. BeirParityTests reads RAGNET_ONNX_EMBED_MODEL,
         RAGNET_ONNX_EMBED_VOCAB and RAGNET_BEIR_CACHE, so RepoConventions requires
         <RequiresSecrets>true</RequiresSecrets> — and that property is declared per PROJECT, not
         per test. Putting the parity test next to the metric and loader unit tests would carry all
         70 of them out of ci.yml's fast gating tier and into nightly.yml's advisory job, where a
         wrong nDCG stops failing pull requests. Task 4 kept the RAGNET_BEIR_CACHE read in
         src/Rag.NET.Benchmarks.Quality for exactly that reason; this project is the other half of
         the same decision.

         So: the arithmetic gates on every push, and the one test that needs an 86 MB model, a
         downloaded corpus and several minutes of CPU runs nightly. -->
    <RequiresSecrets>true</RequiresSecrets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rag.NET.Benchmarks.Quality\Rag.NET.Benchmarks.Quality.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.Embeddings.Onnx\Rag.NET.Embeddings.Onnx.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.Reranking.Onnx\Rag.NET.Reranking.Onnx.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET\Rag.NET.csproj" />
    <!-- The Phase 3.14 Semantic Kernel entrant's pins, exactly as
         docs/reference/library-comparison-defaults.md records them (read 2026-08-02, before the
         entrant was written): Microsoft.SemanticKernel 1.78.0 is the latest stable and the version
         the row is measured at; its retrieval path lives in the InMemory connector, which has
         NEVER shipped a stable version (1.74.0-preview is the latest of any kind), plus
         Microsoft.Extensions.VectorData.Abstractions 10.1.0 — the version SK 1.78.0 itself pins.
         Exact versions, no wildcards: a comparison row measured at a floating version is a row
         nobody can reproduce. -->
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.78.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.InMemory" Version="1.74.0-preview" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit.v3" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
