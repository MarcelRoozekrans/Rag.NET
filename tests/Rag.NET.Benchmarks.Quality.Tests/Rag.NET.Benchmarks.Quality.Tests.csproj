<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- No tier properties on purpose. Nothing here starts a container, and nothing here reads a
         RAGNET_ variable: BeirDatasetCache resolves RAGNET_BEIR_CACHE inside
         src/Rag.NET.Benchmarks.Quality, and every test below hands the loaders an explicit
         temporary directory. That keeps this suite of pure unit tests in ci.yml's fast, gating
         tier — which is the only tier where a wrong nDCG fails a pull request rather than an
         advisory nightly run. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rag.NET.Benchmarks.Quality\Rag.NET.Benchmarks.Quality.csproj" />
    <!-- CachedGraphRagClient, for CachedGraphRagClientOptionsTests. It is an IChatClient decorator
         with no BEIR-cache or network dependency of its own, so it stays in this fast gating tier
         rather than moving to Rag.NET.Benchmarks.Quality.IntegrationTests alongside the tests that
         need RAGNET_ONNX_EMBED_MODEL and friends. -->
    <ProjectReference Include="..\..\benchmarks\Rag.NET.Benchmarks.Quality.GraphExtractions\Rag.NET.Benchmarks.Quality.GraphExtractions.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
