<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- OnnxRerankerTelemetryTests reads RAGNET_ONNX_RERANK_MODEL/_VOCAB, gated the same way
         Rag.NET.Embeddings.Onnx.Tests gates its real-model smoke test. -->
    <RequiresSecrets>true</RequiresSecrets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rag.NET.Reranking.Onnx\Rag.NET.Reranking.Onnx.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

</Project>
