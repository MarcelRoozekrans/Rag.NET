    <ProjectReference Include="..\..\src\Rag.NET.Memory\Rag.NET.Memory.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.QueryTechniques\Rag.NET.QueryTechniques.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.AnswerEngines\Rag.NET.AnswerEngines.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.Chunking\Rag.NET.Chunking.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.Chunking.CSharp\Rag.NET.Chunking.CSharp.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.Chunking.Templates\Rag.NET.Chunking.Templates.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.Mediator\Rag.NET.Mediator.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.GraphRag\Rag.NET.GraphRag.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.VectorStores.PgVector\Rag.NET.VectorStores.PgVector.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.VectorStores.Qdrant\Rag.NET.VectorStores.Qdrant.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.VectorStores.AzureAISearch\Rag.NET.VectorStores.AzureAISearch.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.VectorStores.Weaviate\Rag.NET.VectorStores.Weaviate.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.VectorStores.Chroma\Rag.NET.VectorStores.Chroma.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.VectorStores.Pinecone\Rag.NET.VectorStores.Pinecone.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.Security\Rag.NET.Security.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit.v3" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.*" />
    <PackageReference Include="NSubstitute" Version="5.*" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="9.*" />
  </ItemGroup>

</Project>
