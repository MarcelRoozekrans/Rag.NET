<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <!-- >= 10.0.10: Rag.NET.VectorStores.Weaviate -> ZeroAlloc.Rest transitively requires
         Microsoft.Extensions.Logging 10.0.10; the old 10.0.5 pin became a NU1605 downgrade. -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <ProjectReference Include="..\..\src\Rag.NET\Rag.NET.csproj" />
    <!-- DefaultCompositionTests pins the configured pipeline through UseSqlitePersistence and
         IngestFromProviderTests drives real change-detection through SqliteContentHashStore;
         both live in the Rag.NET.Storage.Sqlite satellite since the package decomposition. -->
    <ProjectReference Include="..\..\src\Rag.NET.Storage.Sqlite\Rag.NET.Storage.Sqlite.csproj" />
    <!-- DefaultCompositionTests pins the configured pipeline through ConfigureResilience and
         PersistentConversationMemoryScoreScaleTests drives memory recall through the real
         ResilientVectorStore decorator; both live in the Rag.NET.Resilience satellite since
         the package decomposition. -->
    <ProjectReference Include="..\..\src\Rag.NET.Resilience\Rag.NET.Resilience.csproj" />
    <!-- DefaultCompositionTests pins the configured pipeline through UseCaching(), which lives
         in the Rag.NET.Caching satellite since the package decomposition. The direct
         Caching.Hybrid package reference below stays: the behaviour tests build a real
         HybridCache via AddHybridCache() themselves. -->
    <ProjectReference Include="..\..\src\Rag.NET.Caching\Rag.NET.Caching.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.Parsers.Epub\Rag.NET.Parsers.Epub.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET.Parsers.Email\Rag.NET.Parsers.Email.csproj" />
