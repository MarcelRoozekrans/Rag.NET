<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The selector nightly.yml's env-gated job greps for. The property name says "secrets" and
         RAGNET_WHISPER_MODEL_DIR is not one — it is a model cache directory, and Whisper runs
         locally with no credential anywhere. The property is the repository's existing name for
         "this project needs something the job must provision", and renaming it across six projects,
         three workflows and two guards is a larger change than this test justifies. -->
    <RequiresSecrets>true</RequiresSecrets>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.Linq.Async" />
    <ProjectReference Include="..\..\src\Rag.NET.Parsers.Audio\Rag.NET.Parsers.Audio.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET\Rag.NET.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <!-- Milestone 6, Phase 6.2: a real WAV, synthesised by Windows' speech engine rather than by
         anything related to Whisper, so a pass means two independent implementations agree. -->
    <None Include="Resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
