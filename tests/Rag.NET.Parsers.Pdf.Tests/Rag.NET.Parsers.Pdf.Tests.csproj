<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Mirrors the parser's OCR gate so gate-conditional tests (the gate-off construction
         throw, the gated real-Tesseract integration test) compile consistently with the
         parser when building with /p:EnableOcr=true. -->
    <DefineConstants Condition="'$(EnableOcr)'=='true'">$(DefineConstants);ENABLE_OCR</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rag.NET.Parsers.Pdf\Rag.NET.Parsers.Pdf.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET\Rag.NET.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit.v3" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Single source of truth for PDF fixtures: linked from the integration test resources. -->
    <EmbeddedResource Include="..\Rag.NET.Parsers.IntegrationTests\Resources\sample.pdf"
                      Link="Resources\sample.pdf"
                      LogicalName="Rag.NET.Parsers.Pdf.Tests.Resources.sample.pdf" />
    <EmbeddedResource Include="..\Rag.NET.Parsers.IntegrationTests\Resources\sample-table.pdf"
                      Link="Resources\sample-table.pdf"
                      LogicalName="Rag.NET.Parsers.Pdf.Tests.Resources.sample-table.pdf" />
    <EmbeddedResource Include="..\Rag.NET.Parsers.IntegrationTests\Resources\sample-scanned.pdf"
                      Link="Resources\sample-scanned.pdf"
                      LogicalName="Rag.NET.Parsers.Pdf.Tests.Resources.sample-scanned.pdf" />
    <!-- Source image embedded in sample-scanned.pdf; used by ScannedFixtureGenerator. -->
    <EmbeddedResource Include="Resources\ocr-sample.png"
                      LogicalName="Rag.NET.Parsers.Pdf.Tests.Resources.ocr-sample.png" />
  </ItemGroup>

</Project>
