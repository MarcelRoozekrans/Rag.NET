<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- OnnxEmbeddingGeneratorSmokeTests reads RAGNET_ONNX_EMBED_MODEL and RAGNET_ONNX_EMBED_VOCAB
         and calls Assert.Skip when either is absent or does not point at an existing file, so this
         project is safe in every tier and simply skips that test. The declaration exists so
         nightly.yml can select it and supply the paths — the only run where OnnxEmbeddingGenerator
         meets a real ONNX model. -->
    <RequiresSecrets>true</RequiresSecrets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rag.NET.Embeddings.Onnx\Rag.NET.Embeddings.Onnx.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET\Rag.NET.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit.v3" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
