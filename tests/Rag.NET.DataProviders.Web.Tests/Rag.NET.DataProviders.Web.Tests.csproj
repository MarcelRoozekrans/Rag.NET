<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rag.NET.DataProviders.Web\Rag.NET.DataProviders.Web.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Shared connector-metadata contract check. Linked rather than referenced: there is no
         shared unit-test library, and a project reference to another test project would drag
         its whole assembly along. Same pattern as src/Shared/GraphErrorMapping.cs. -->
    <Compile Include="..\Rag.NET.DataProviders.Tests\MetadataContract.cs" Link="MetadataContract.cs" />
  </ItemGroup>
</Project>
