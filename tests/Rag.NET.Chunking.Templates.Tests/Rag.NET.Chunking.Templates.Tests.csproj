<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rag.NET.Chunking.Templates\Rag.NET.Chunking.Templates.csproj" />
    <!-- Both packages, in one test project. Nothing referenced both until Phase 3.11, which is a
         large part of why two parsers claiming application/octet-stream went unnoticed: the
         collision only exists once Rag.NET.Chunking.Templates and Rag.NET.Parsers.Email share a
         parser collection. Neither package needs Docker or a model, so no tier declaration. -->
    <ProjectReference Include="..\..\src\Rag.NET.Parsers.Email\Rag.NET.Parsers.Email.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET\Rag.NET.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <!-- AddLogging/AddProvider, so QAPairsAttachmentClaimTests can assert *why* an attachment was
         skipped. Containment makes "no parser claimed it" and "a parser claimed it and threw"
         produce identical sections; only the log tells them apart. -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" />
  </ItemGroup>


  <!-- The real paper RealPaperExerciseTests runs through the real markdown parser. Embedded rather
       than copied to output so the test cannot silently pass against a stale file on disk. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" />
  </ItemGroup>
</Project>
