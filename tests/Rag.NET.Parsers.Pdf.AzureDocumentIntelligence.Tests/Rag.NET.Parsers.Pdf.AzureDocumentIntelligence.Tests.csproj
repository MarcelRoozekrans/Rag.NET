<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Reads RAGNET_DOCINTEL_ENDPOINT and RAGNET_DOCINTEL_KEY and calls Assert.Skip when either
         is absent, so this project is safe in every tier and simply skips that test. The
         declaration exists so nightly.yml can select it and supply the values, which is the only
         run where the live Azure Document Intelligence path executes — and it bills one page. -->
    <RequiresSecrets>true</RequiresSecrets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rag.NET.Parsers.Pdf.AzureDocumentIntelligence\Rag.NET.Parsers.Pdf.AzureDocumentIntelligence.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET\Rag.NET.csproj" />
    <ProjectReference Include="..\Rag.NET.Testing\Rag.NET.Testing.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="WireMock.Net" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the parser suites: the same scanned fixture the Tesseract path uses, so
         the env-gated live test submits a document that genuinely needs OCR. -->
    <EmbeddedResource Include="..\Rag.NET.Parsers.IntegrationTests\Resources\sample-scanned.pdf"
                      Link="Resources\sample-scanned.pdf"
                      LogicalName="Rag.NET.Parsers.Pdf.AzureDocumentIntelligence.Tests.Resources.sample-scanned.pdf" />
  </ItemGroup>

</Project>
