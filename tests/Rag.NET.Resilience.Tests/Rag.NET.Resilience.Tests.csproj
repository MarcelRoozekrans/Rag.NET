<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared ledger fake, compiled into Rag.NET.Tests as well: ResilienceStackingTests
         proves the documented UseFallbackChain → UseRateLimiting → UseCostBudgeting order
         against the same deterministic ledger core's CostTracking* tests use on the other
         side of the package boundary. -->
    <Compile Include="..\Rag.NET.Tests\Resilience\FakeCostLedger.cs" Link="Resilience\FakeCostLedger.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rag.NET.Resilience\Rag.NET.Resilience.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET\Rag.NET.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit.v3" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="NSubstitute" Version="5.*" />
  </ItemGroup>

</Project>
