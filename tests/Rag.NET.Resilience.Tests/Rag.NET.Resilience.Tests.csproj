<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared ledger fake, compiled into Rag.NET.Tests as well: ResilienceStackingTests
         proves the documented UseFallbackChain → UseRateLimiting → UseCostBudgeting order
         against the same deterministic ledger core's CostTracking* tests use on the other
         side of the package boundary. -->
    <Compile Include="..\Rag.NET.Tests\Resilience\FakeCostLedger.cs" Link="Resilience\FakeCostLedger.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rag.NET.Resilience\Rag.NET.Resilience.csproj" />
    <ProjectReference Include="..\..\src\Rag.NET\Rag.NET.csproj" />
    <!-- FakeTimeProvider, for DefaultPolicyBackoffTests: the shipped default's exponential
         back-off cannot be asserted against a real clock without a ~7 s sleep. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

</Project>
