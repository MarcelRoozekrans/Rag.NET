<Project Sdk="Microsoft.NET.Sdk">

  <!-- No <RequiresDocker> and no <RequiresLlm>: these tests build zip fixtures in memory and assert
       on byte counts, or read Resources/sample.zip off disk. A stale tier declaration fails
       Rag.NET.RepoConventions.Tests as loudly as a missing one, so neither is declared. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rag.NET.Parsers.Archive\Rag.NET.Parsers.Archive.csproj" />
    <!-- NestedContainerBudgetTests needs a second container format on the other side of the
         IDocumentParser boundary. A zip-only chain cannot show that the depth counter and the entry
         budget are shared rather than per-package, which is the whole justification for promoting
         the container machinery into Rag.NET.Abstractions. -->
    <ProjectReference Include="..\..\src\Rag.NET.Parsers.Email\Rag.NET.Parsers.Email.csproj" />
    <!-- BuildServiceProvider, for the test that the declared ParserClaims match CanParse. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Milestone 6, Phase 6.2: a real ZIP, written by CPython's zipfile rather than by the
         System.IO.Compression that ZipDocumentParser reads with. -->
    <EmbeddedResource Include="Resources\**\*" />
  </ItemGroup>

</Project>
