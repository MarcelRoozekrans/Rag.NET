{
  // Rag.NET.QuickStart's configuration, read by Rag.NET.Hosting's
  // AddRagNetPipelineFromConfiguration. Every value here can also be set as an environment
  // variable using "__" as the section separator, e.g. RagNet__ChatClient__ApiKey — that is how
  // to switch providers without editing this file (see the three blocks below).
  "RagNet": {
    // Defaults to a local Ollama instance (http://localhost:11434/v1) so this sample needs no
    // API key out of the box — only `ollama pull llama3.2` and `ollama pull nomic-embed-text`
    // running locally. ApiKey may stay empty because the endpoint is a loopback address;
    // AddRagNetPipelineFromConfiguration requires a real key for anything else.
    //
    // To use OpenAI instead, set (as environment variables, never committed):
    //   RagNet__ChatClient__Endpoint=https://api.openai.com/v1
    //   RagNet__ChatClient__ApiKey=sk-...
    //   RagNet__ChatClient__Model=gpt-4o-mini
    //   RagNet__Embeddings__Endpoint=https://api.openai.com/v1
    //   RagNet__Embeddings__ApiKey=sk-...
    //   RagNet__Embeddings__Model=text-embedding-3-small
    //   RagNet__Embeddings__VectorDimensions=1536
    "ChatClient": {
      "Endpoint": "http://localhost:11434/v1",
      "ApiKey": "",
      "Model": "llama3.2"
    },
    "Embeddings": {
      "Endpoint": "http://localhost:11434/v1",
      "ApiKey": "",
      "Model": "nomic-embed-text",
      "VectorDimensions": 768
    },
    // "InMemory" — the default — needs no external service, but every ingested document is lost
    // the moment the process exits; Rag.NET.Hosting logs a warning at startup saying so. Set
    // Kind to "Qdrant" or "PgVector" (with the matching block below) for a store that survives
    // between runs.
    "VectorStore": {
      "Kind": "InMemory"
    }
  }
}
