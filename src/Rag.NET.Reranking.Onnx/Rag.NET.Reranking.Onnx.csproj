<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.Reranking.Onnx</RootNamespace>
    <PackageId>Rag.NET.Reranking.Onnx</PackageId>
    <Description>ONNX Runtime cross-encoder reranking for Rag.NET</Description>
    <PackageTags>$(PackageTags);reranking;cross-encoder;onnx</PackageTags>
    <!-- benchmark: OnnxReranker is the +reranker ablation cell on SciFact, FiQA and ArguAna,
         pinned in BeirReproduction at ±0.005 — the run that found it destroying 26% of every
         document as [UNK] (Phase 3.15) and now guards the fix. Milestone 6.0, 2026-08-15. -->
    <VerifiedBy>benchmark</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <!-- One definition, compiled into each package that feeds BERT token ids to an ONNX model.
         Linked rather than referenced: a ProjectReference to Rag.NET.Embeddings.Onnx would make
         every cross-encoder consumer drag in a dense embedder to get a tokenizer. -->
    <Compile Include="..\Shared\BertWordPieceTokenization.cs" Link="Bert\BertWordPieceTokenization.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The "Rag.NET"-named ActivitySource core also links; see src/Shared/RagTelemetrySource.cs.
         Linked, not referenced: a ProjectReference to core would pull the whole pipeline into a
         reranker. -->
    <Compile Include="..\Shared\RagTelemetrySource.cs" Link="Telemetry\RagTelemetrySource.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.Abstractions\Rag.NET.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Reranking.Onnx.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
