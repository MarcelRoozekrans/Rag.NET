<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.Hosting</RootNamespace>
    <PackageId>Rag.NET.Hosting</PackageId>
    <Description>Configuration-driven pipeline wiring for hosting Rag.NET in an executable: binds a RagNet configuration section to an OpenAI-compatible chat client and embedding generator, and one of the InMemory, Qdrant, or PgVector vector stores.</Description>
    <!-- unit: every kind AddRagNetPipelineFromConfiguration can wire, and the chat/embedding
         client construction, are exercised by Rag.NET.Hosting.Tests against an in-memory
         IConfiguration. Client and store construction never dials out (Uri/credential setup and
         gRPC/Npgsql client construction are lazy about the network), so this is real coverage of
         what gets registered, not a fake standing in for a network call. -->
    <VerifiedBy>unit</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET\Rag.NET.csproj" />
    <!-- The two vector-store kinds this package wires beyond InMemory (already in core Rag.NET).
         Deliberately not the other four store packages, and not Weaviate/Pinecone/Chroma/Azure AI
         Search/ONNX embeddings at all — see the design's bounded provider set (§1.1/§1.2). -->
    <ProjectReference Include="..\Rag.NET.VectorStores.Qdrant\Rag.NET.VectorStores.Qdrant.csproj" />
    <ProjectReference Include="..\Rag.NET.VectorStores.PgVector\Rag.NET.VectorStores.PgVector.csproj" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>

</Project>
