<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.Raptor</RootNamespace>
    <PackageId>Rag.NET.Raptor</PackageId>
    <Description>RAPTOR — Recursive Abstractive Processing for Tree-Organized Retrieval for Rag.NET</Description>
    <PackageTags>$(PackageTags);raptor;hierarchical-summarization</PackageTags>
    <!-- benchmark: measured 2026-08-25 over the full 609-article MultiHop-RAG corpus (17,648
         leaf chunks) with openai/gpt-4o-mini at temperature 0, top-6 context — four arms,
         10,224 scored answers, accuracy over the 2,255 judged queries. Pinned and asserted in
         MultiHopRagAnswerReproduction under multihop-rag: raptor 0.3734 (the per-document
         control), raptorcorpus 0.3588 (the shipped default), raptorfiltered 0.3499 (the
         validation gate — it reproduces the dense arm's pinned 0.3499/0.2603/0.3242 to four
         decimals, which is what makes the rest of the run readable), raptorboost 0.3450.
         The finding is not that RAPTOR is good: corpus scope measured 0.0146 WORSE than the
         per-document tree it replaced (McNemar p=0.0247), concentrated in inference queries.
         Milestone 6's bar is measured, not good. Protocol and reading in
         docs/plans/2026-08-21-raptor-real-protocol-implementation.md and docs/guide/raptor.md's
         Measured section. Still exercised at the integration level too, by RaptorTreeScopeTests
         and RaptorCorpusBuildTests over a real SqliteRaptorLeafStore. -->
    <VerifiedBy>benchmark</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Raptor.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Benchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- The "Rag.NET"-named ActivitySource core also links; see src/Shared/RagTelemetrySource.cs.
         Linked rather than reached through the ProjectReference to core below: every
         instrumented package gets its own instance of the same name, uniformly, regardless of
         whether it also happens to depend on core for other reasons. -->
    <Compile Include="..\Shared\RagTelemetrySource.cs" Link="Telemetry\RagTelemetrySource.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET\Rag.NET.csproj" />
    <ProjectReference Include="..\Rag.NET.Raptor.Store\Rag.NET.Raptor.Store.csproj" />
    <PackageReference Include="MathNet.Numerics" />
    <!-- The runtime library flows transitively through Rag.NET, but the generator is
         PrivateAssets="all" there and analyzers do not flow — [Validate] on this package's
         options types emits nothing without a direct generator reference. -->
    <PackageReference Include="ZeroAlloc.Validation" />
    <PackageReference Include="ZeroAlloc.Validation.Generator" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
