<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Rag.NET.Security.AspNetCore</RootNamespace>
    <PackageId>Rag.NET.Security.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for Rag.NET.Security — binds ICallerContext to ClaimsPrincipal.</Description>
    <!-- unit: Rag.NET.Security.AspNetCore.Tests drives ClaimsPrincipalCallerContext directly against
         real ASP.NET Core primitives (HttpContextAccessor, DefaultHttpContext, ClaimsPrincipal), and
         drives AddRagNetAspNetCoreSecurity through a real TestServer pipeline — concurrent requests
         with different role claims, a pre-registered ICallerContext surviving TryAddSingleton, and
         UseRbac()'s guard actually filtering a chunk end-to-end for a caller who lacks the role. What
         `unit` does not cover: a real reverse proxy or authentication handler populating the
         ClaimsPrincipal (Kestrel/JWT/cookie middleware) — TestServer's in-memory pipeline stands in
         for that, same limitation TraceEndpointTests documents for Rag.NET.Diagnostics.AspNetCore. -->
    <VerifiedBy>unit</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.Security\Rag.NET.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

</Project>
