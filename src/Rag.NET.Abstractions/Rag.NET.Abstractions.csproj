<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.Abstractions</RootNamespace>
    <PackageId>Rag.NET.Abstractions</PackageId>
    <Description>Interfaces and models for the Rag.NET library</Description>
    <VerifiedBy>unit</VerifiedBy>
    <!-- Milestone 6, Phase 6.2 §2(e). This package ships interfaces, records and option types and
         no executable behaviour of its own, so there is nothing here to run against a real model,
         a real file or a real service — "exercised beyond fakes" has no referent for it. What
         exercises these types is every real run of every package built on them: the BEIR
         reproductions, the container suites, the real-file parser tests. Upgrading the level would
         claim a run this package cannot have; a bare unit would hide that the question was asked
         and answered. This is a completion, not a concession. -->
    <VerifiedByReason>Interfaces, records and option types only — no executable behaviour to exercise. Verified transitively by every real run of the packages built on it; nothing is left unverified that a run of this package could cover.</VerifiedByReason>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Storage.Sqlite</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.VectorStores.PgVector</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.VectorStores.Qdrant</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.VectorStores.AzureAISearch</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.VectorStores.Weaviate</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.VectorStores.Chroma</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.VectorStores.Pinecone</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Evaluation.Ragas</_Parameter1>
    </AssemblyAttribute>
    <!-- The next five exist for LlmJsonExtractor: every assembly that parses structured JSON
         out of a chat-model response routes through that one internal helper rather than
         growing its own fence-stripping copy (the copies drifted, and the drift shipped a
         GraphRAG that extracted nothing — see the helper's remarks). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.GraphRag</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Evaluation</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Chunking</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Chunking.Templates</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.AnswerEngines</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Benchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="ZeroAlloc.Results" />
    <!-- Generators ship under analyzers/dotnet/cs and are auto-wired by the SDK;
         Validation.Generator bundles ZeroAlloc.Pipeline(.Generators), so no standalone
         Pipeline.Generators reference or explicit Analyzer items are needed. -->
    <!-- Specification 1.1.0 bundles its generator — a separate Specification.Generator
         reference would run the generator twice (duplicate And/Or/Not members). -->
    <PackageReference Include="ZeroAlloc.Specification" />
    <PackageReference Include="ZeroAlloc.Validation" />
    <PackageReference Include="ZeroAlloc.Validation.Generator" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Pinned exactly: floating versions made builds non-reproducible. The generator always
         emits ToString(); since 1.7.x the single-property form returns the raw value, so the
         value-object types must not hand-write their own ToString. -->
    <PackageReference Include="ZeroAlloc.ValueObjects" />
  </ItemGroup>

</Project>
