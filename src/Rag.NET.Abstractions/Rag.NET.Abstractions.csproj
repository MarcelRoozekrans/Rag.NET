<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.Abstractions</RootNamespace>
    <PackageId>Rag.NET.Abstractions</PackageId>
    <Description>Interfaces and models for the Rag.NET library</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.VectorStores.PgVector</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.VectorStores.Qdrant</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.VectorStores.AzureAISearch</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Evaluation.Ragas</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Benchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    <PackageReference Include="ZeroAlloc.Results" Version="1.2.0" />
    <!-- Generators ship under analyzers/dotnet/cs and are auto-wired by the SDK;
         Validation.Generator bundles ZeroAlloc.Pipeline(.Generators), so no standalone
         Pipeline.Generators reference or explicit Analyzer items are needed. -->
    <!-- Specification 1.1.0 bundles its generator — a separate Specification.Generator
         reference would run the generator twice (duplicate And/Or/Not members). -->
    <PackageReference Include="ZeroAlloc.Specification" Version="1.1.0" />
    <PackageReference Include="ZeroAlloc.Validation" Version="1.5.3" />
    <PackageReference Include="ZeroAlloc.Validation.Generator" Version="1.5.3" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Pinned exactly: floating versions made builds non-reproducible. The generator always
         emits ToString(); since 1.7.x the single-property form returns the raw value, so the
         value-object types must not hand-write their own ToString. -->
    <PackageReference Include="ZeroAlloc.ValueObjects" Version="1.7.1" />
  </ItemGroup>

</Project>
