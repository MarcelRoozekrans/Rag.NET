<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.Embeddings.Onnx</RootNamespace>
    <PackageId>Rag.NET.Embeddings.Onnx</PackageId>
    <Description>ONNX Runtime token-level embeddings for Rag.NET (late chunking)</Description>
    <PackageTags>$(PackageTags);onnx;late-chunking;local-embeddings</PackageTags>
    <!-- unit: tokenisation, pooling and stitching are covered with fixtures on every run;
         the real-model tests are env-gated local inference (RAGNET_ONNX_EMBED_*) — a local
         fixture, not a container or a service. -->
    <VerifiedBy>unit</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <!-- One definition, compiled into each package that feeds BERT token ids to an ONNX model.
         It cannot live in the shared Rag.NET.Abstractions package: that package references
         neither Microsoft.ML.Tokenizers nor ONNX Runtime, and must not start. -->
    <Compile Include="..\Shared\BertWordPieceTokenization.cs" Link="Bert\BertWordPieceTokenization.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.Abstractions\Rag.NET.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Declared explicitly because this package uses ILogger<> and [LoggerMessage] directly.
         It compiled without this until ZeroAlloc.ValueObjects 2.0.0, which dropped its
         Microsoft.Extensions.Hosting.Abstractions dependency — that had been supplying
         Logging.Abstractions transitively through Rag.NET.Abstractions. A package should
         declare what it uses rather than inherit it by accident. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Embeddings.Onnx.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
