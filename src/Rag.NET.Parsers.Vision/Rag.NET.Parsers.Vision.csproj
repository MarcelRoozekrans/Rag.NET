<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.Parsers.Vision</RootNamespace>
    <PackageId>Rag.NET.Parsers.Vision</PackageId>
    <Description>Image and video description parsers for Rag.NET using a vision LLM and FFMpeg</Description>
    <VerifiedBy>live</VerifiedBy>
    <VerifiedByReason>ImageDocumentParser sends a real PNG to a real hosted vision model over
      OpenRouter (RealVisionModelTests). The model reads the words drawn in the image back verbatim
      and names the red circle, and a negative control on a blank image confirms both assertions
      fail when the content is absent. Gated on OPENROUTER_API_KEY; ~$0.0004 per run.</VerifiedByReason>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Parsers.Vision.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.Abstractions\Rag.NET.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Set EnableOcr=true in your project to enable TryOcrBeforeVision support. -->
    <DefineConstants Condition="'$(EnableOcr)'=='true'">$(DefineConstants);ENABLE_OCR</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFMpegCore" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Tesseract" Condition="'$(EnableOcr)'=='true'" />
  </ItemGroup>

</Project>
