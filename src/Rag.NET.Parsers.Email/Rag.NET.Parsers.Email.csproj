<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.Parsers.Email</RootNamespace>
    <PackageId>Rag.NET.Parsers.Email</PackageId>
    <Description>EML/MSG email parser for Rag.NET</Description>
    <!-- Milestone 6, Phase 6.2: a real .eml and .msg parsed with content assertions (Parsers.IntegrationTests). -->
    <VerifiedBy>integration</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.Abstractions\Rag.NET.Abstractions.csproj" />
    <ProjectReference Include="..\Rag.NET.Parsers.Html\Rag.NET.Parsers.Html.csproj" />
    <PackageReference Include="MimeKit" />
    <PackageReference Include="MsgReader" />
    <!-- Not used directly. Referenced only to lift the copy MimeKit and MsgReader brings in (10.0.12) to
         10.0.13: GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx cover 10.0.0-10.0.12, and the
         NU1902/NU1903 audit warnings fail the build. Drop this once MimeKit and MsgReader depends on 10.0.13+. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- EmbeddedMessageMetadata is internal and composes the parent#child attachment name.
         Driving it through a parser fixture would pin the fixture, not the naming rules, so
         the tests call it directly. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Parsers.Email.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
