<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.VectorStores.AzureAISearch</RootNamespace>
    <PackageId>Rag.NET.VectorStores.AzureAISearch</PackageId>
    <Description>Azure AI Search vector store for Rag.NET</Description>
    <!-- unit, not container, deliberately: the Docker-tier suite runs against a community
         azure-ai-search-simulator, not the real service. It implements no OData filter
         expressions (the filtered-search test is permanently skipped) and nothing has ever
         confirmed it behaves like real Azure AI Search. A simulator of unverified fidelity
         is a fake with a port number. -->
    <VerifiedBy>unit</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.VectorStores.AzureAISearch.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.Abstractions\Rag.NET.Abstractions.csproj" />
    <PackageReference Include="Azure.Search.Documents" />
  </ItemGroup>

</Project>
