<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Rag.NET.DataProviders.AzureBlob</RootNamespace>
    <PackageId>Rag.NET.DataProviders.AzureBlob</PackageId>
    <Description>Azure Blob Storage data provider for Rag.NET</Description>
    <!-- Milestone 6, Phase 6.1: exercised against Azurite, MICROSOFT'S OWN Blob emulator, via
         Testcontainers — real blobs uploaded over the real Azure SDK and enumerated back,
         including the content fetch and the Last-Modified a real server sets
         (Rag.NET.DataProviders.AzureBlob.IntegrationTests). A vendor emulator, so the same
         class as Pinecone's pinecone-local rather than a third-party reimplementation. -->
    <VerifiedBy>container</VerifiedBy>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.DataProviders\Rag.NET.DataProviders.csproj" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
