<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Rag.NET.DataProviders.Box</RootNamespace>
    <PackageId>Rag.NET.DataProviders.Box</PackageId>
    <Description>Box data provider for Rag.NET</Description>
    <!-- Box.V2 3.x targets .NET Framework only; suppress compatibility and vulnerability
         audit warnings that are known third-party limitations and cannot be resolved until
         Box publishes a .NET-native SDK. -->
    <NoWarn>$(NoWarn);NU1701;NU1900;NU1902;NU1903</NoWarn>
    <VerifiedBy>unit</VerifiedBy>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.DataProviders\Rag.NET.DataProviders.csproj" />
    <PackageReference Include="Box.V2" Version="3.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- BoxClient is a concrete type with no injectable transport, so the enumeration paths
         cannot be driven from a unit test. ToHandle/MapChangeStatus are the seam that pins the
         metadata this connector emits. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.DataProviders.Box.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
