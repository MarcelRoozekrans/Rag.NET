<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Rag.NET.DataProviders.Box</RootNamespace>
    <PackageId>Rag.NET.DataProviders.Box</PackageId>
    <Description>Box data provider for Rag.NET</Description>
    <VerifiedBy>unit</VerifiedBy>
    <VerifiedByReason>Box API via Box.V2. No account or credential for it exists on this project, so no scrubbed
      recording can be made; that is the blocker, and it is not effort. Coverage is unit tests over
      fakes and an SDK boundary; no HTTP exchange with the service is exercised at all. What stays
      unverified: request shape, authentication, pagination on real data, and error and rate-limit
      handling — everything the SDK does on the wire.</VerifiedByReason>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.DataProviders\Rag.NET.DataProviders.csproj" />
    <PackageReference Include="Box.V2.Core" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- The enumeration paths (folder recursion, delta/events) are now reachable from a unit
         test through NetworkSession.WithNetworkClient(INetworkClient) on the Box.Sdk.Gen SDK.
         ToHandle/MapChangeStatus stay internal regardless, as the seam that pins the exact
         metadata this connector emits without going through a fake transport for every case. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.DataProviders.Box.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
