<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.Chunking</RootNamespace>
    <PackageId>Rag.NET.Chunking</PackageId>
    <Description>Hierarchical-merge, code-aware, late and proposition chunking strategies for Rag.NET</Description>
    <PackageTags>$(PackageTags);late-chunking;propositions</PackageTags>
    <VerifiedBy>unit</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="0.*" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.Abstractions\Rag.NET.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
