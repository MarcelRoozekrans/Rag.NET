<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.Parsers.Archive</RootNamespace>
    <PackageId>Rag.NET.Parsers.Archive</PackageId>
    <Description>ZIP archive parser for Rag.NET</Description>
    <VerifiedBy>unit</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.IO.Compression is in the BCL, so this package adds no third-party dependency. -->
    <ProjectReference Include="..\Rag.NET.Abstractions\Rag.NET.Abstractions.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bomb bounds are internal: RequestedMax* exists only so the registration extension can
         throw on a request the setter has already clamped, and the read-limiting machinery is an
         implementation detail of the parser. Both are asserted directly, because driving them
         through the parser would pin the parser rather than the bounds. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Parsers.Archive.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
