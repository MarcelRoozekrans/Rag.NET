<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Rag.NET.Mcp.Tool</RootNamespace>
    <PackageId>Rag.NET.Mcp.Tool</PackageId>
    <ToolCommandName>ragnet-mcp</ToolCommandName>
    <PackAsTool>true</PackAsTool>
    <!-- Load-bearing: Microsoft.NET.Sdk.Web defaults IsPackable to false, which silently turned
         this configured dotnet tool into a package that never shipped — every solution pack
         emitted a codeless "packaging has been disabled" advisory and produced nothing.
         PackabilityTests guards the pairing. -->
    <IsPackable>true</IsPackable>
    <Description>Self-contained MCP server for Rag.NET. Configure via appsettings.json or environment variables.</Description>
    <PackageTags>$(PackageTags);mcp;model-context-protocol;dotnet-tool</PackageTags>
    <!-- No test anywhere runs this host: it is a Program.cs scaffold that no test project
         references. Honest state, recorded; getting it above none is later Milestone 4 work. -->
    <VerifiedBy>none</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.Mcp\Rag.NET.Mcp.csproj" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.1.0" />
  </ItemGroup>
</Project>
