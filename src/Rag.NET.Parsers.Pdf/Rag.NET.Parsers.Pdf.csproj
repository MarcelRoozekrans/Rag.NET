<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.Parsers.Pdf</RootNamespace>
    <PackageId>Rag.NET.Parsers.Pdf</PackageId>
    <Description>PDF document parser for Rag.NET</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Parsers.Pdf.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <!-- Set EnableOcr=true in your project to enable the UseOcrFallback support.
         Deliberate duplication of Rag.NET.Parsers.Vision's OCR gate: parser packages stay
         decoupled; a future shared OCR package is the consolidation path. -->
    <DefineConstants Condition="'$(EnableOcr)'=='true'">$(DefineConstants);ENABLE_OCR</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.Abstractions\Rag.NET.Abstractions.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="PdfPig" Version="0.*" />
    <PackageReference Include="Tesseract" Version="5.*" Condition="'$(EnableOcr)'=='true'" />
  </ItemGroup>

</Project>
