<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Rag.NET.DataProviders.Linear</RootNamespace>
    <PackageId>Rag.NET.DataProviders.Linear</PackageId>
    <Description>Linear issue tracker data provider for Rag.NET</Description>
    <VerifiedBy>unit</VerifiedBy>
    <VerifiedByReason>Linear GraphQL API. No account or credential for it exists on this project, so no scrubbed
      recording can be made; that is the blocker, and it is not effort. Its integration coverage replays
      a HAND-WRITTEN WireMock cassette rather than a recording, so it verifies the parser against
      fixtures written alongside the parser itself. What stays unverified: that the real service's
      response shape matches those fixtures, that authentication is accepted, that pagination terminates
      on real data, and that error and rate-limit responses are handled. The request matchers key on
      path and method, so a credential is never examined by any assertion.</VerifiedByReason>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.DataProviders\Rag.NET.DataProviders.csproj" />
    <PackageReference Include="ZeroAlloc.Rest" />
    <PackageReference Include="ZeroAlloc.Rest.SystemTextJson" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.DataProviders.Linear.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Benchmarks</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.DataProviders.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
