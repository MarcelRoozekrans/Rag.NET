<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Rag.NET.DataProviders.Microsoft365</RootNamespace>
    <PackageId>Rag.NET.DataProviders.Microsoft365</PackageId>
    <Description>Microsoft 365 data providers for Rag.NET: Exchange / Outlook mail, Microsoft Teams, OneDrive and SharePoint via Microsoft Graph</Description>
    <VerifiedBy>unit</VerifiedBy>
  </PropertyGroup>
  <ItemGroup>
    <!-- One definition, compiled into each Graph connector. It cannot live in the shared
         Rag.NET.DataProviders package: that package references neither Microsoft.Graph,
         Kiota, nor Azure.Identity, and must not start. -->
    <Compile Include="..\Shared\GraphErrorMapping.cs" Link="Graph\GraphErrorMapping.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.DataProviders\Rag.NET.DataProviders.csproj" />
    <PackageReference Include="Microsoft.Graph" Version="5.*" />
    <!-- Audit lift: Microsoft.Graph 5.x pins Microsoft.Kiota.Abstractions 1.21.1 (GHSA-7j59-v9qr-6fq9, patched in 1.22.0). -->
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="1.22.0" />
    <PackageReference Include="Azure.Identity" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.DataProviders.Microsoft365.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
