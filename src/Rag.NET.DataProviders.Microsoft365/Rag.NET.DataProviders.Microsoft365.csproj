<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Rag.NET.DataProviders.Microsoft365</RootNamespace>
    <PackageId>Rag.NET.DataProviders.Microsoft365</PackageId>
    <Description>Microsoft 365 data providers for Rag.NET: Exchange / Outlook mail, Microsoft Teams, OneDrive and SharePoint via Microsoft Graph</Description>
    <VerifiedBy>unit</VerifiedBy>
    <VerifiedByReason>Microsoft Graph. No account or credential for it exists on this project, so no scrubbed recording
      can be made; that is the blocker, and it is not effort. Its integration coverage replays a
      HAND-WRITTEN WireMock cassette rather than a recording, so it verifies the parser against fixtures
      written alongside the parser itself. What stays unverified: that the real service's response shape
      matches those fixtures, that authentication is accepted, that pagination terminates on real data,
      and that error and rate-limit responses are handled. The request matchers key on path and method,
      so a credential is never examined by any assertion.</VerifiedByReason>
  </PropertyGroup>
  <ItemGroup>
    <!-- One definition, compiled into each Graph connector. It cannot live in the shared
         Rag.NET.DataProviders package: that package references neither Microsoft.Graph,
         Kiota, nor Azure.Identity, and must not start. -->
    <Compile Include="..\Shared\GraphErrorMapping.cs" Link="Graph\GraphErrorMapping.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.DataProviders\Rag.NET.DataProviders.csproj" />
    <PackageReference Include="Microsoft.Graph" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.DataProviders.Microsoft365.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
