<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.AnswerEngines</RootNamespace>
    <PackageId>Rag.NET.AnswerEngines</PackageId>
    <Description>MapReduce, Refine, FLARE and Dispatching answer engines for Rag.NET, with self-assessment confidence scoring</Description>
    <!-- unit, not container, deliberately: the engines meet a real LLM only in the advisory
         nightly E2E job, whose failures gate nothing and whose assertions on model-written
         text are measured flaky. The verification that can be relied on is the fakes. -->
    <VerifiedBy>benchmark</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET\Rag.NET.csproj" />
  </ItemGroup>

</Project>
