<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET</RootNamespace>
    <PackageId>Rag.NET</PackageId>
    <Description>Modular RAG pipeline library for .NET</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Lifts transitive SQLitePCLRaw.lib.e_sqlite3 above 2.1.11 (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Resilience" Version="10.*" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="0.*" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="0.*" />
    <PackageReference Include="ZeroAlloc.Inject" Version="1.2.1" />
    <PackageReference Include="ZeroAlloc.Results" Version="0.*" />
    <PackageReference Include="ZeroAlloc.Inject.Generator" Version="1.2.1" PrivateAssets="all" ExcludeAssets="runtime" GeneratePathProperty="true" />
    <PackageReference Include="ZeroAlloc.Specification" Version="0.*" GeneratePathProperty="true" />
    <PackageReference Include="ZeroAlloc.Specification.Generator" Version="0.*" PrivateAssets="all" ExcludeAssets="runtime" GeneratePathProperty="true" />
    <PackageReference Include="ZeroAlloc.Validation" Version="0.*" GeneratePathProperty="true" />
    <PackageReference Include="ZeroAlloc.Pipeline" Version="0.*" GeneratePathProperty="true" />
    <PackageReference Include="ZeroAlloc.Pipeline.Generators" Version="0.*" PrivateAssets="all" ExcludeAssets="runtime" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.Abstractions\Rag.NET.Abstractions.csproj" />
    <ProjectReference Include="..\Rag.NET.QueryTechniques\Rag.NET.QueryTechniques.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Analyzer Include="$(PkgZeroAlloc_Inject_Generator)\analyzers\dotnet\cs\ZeroAlloc.Inject.Generator.dll" />
    <!-- ZeroAlloc.Validation.Generator is not yet published to NuGet (IsPackable=false).
         Built locally from C:\Projects\Prive\ZeroAlloc\ZeroAlloc.Validation -->
    <Analyzer Include="C:\Projects\Prive\ZeroAlloc\ZeroAlloc.Validation\src\ZeroAlloc.Validation.Generator\bin\Release\netstandard2.0\ZeroAlloc.Validation.Generator.dll" />
    <Analyzer Include="$(PkgZeroAlloc_Pipeline_Generators)\lib\netstandard2.0\ZeroAlloc.Pipeline.Generators.dll" />
    <Analyzer Include="$(PkgZeroAlloc_Pipeline)\lib\netstandard2.0\ZeroAlloc.Pipeline.dll" />
    <Analyzer Include="$(PkgZeroAlloc_Specification_Generator)\analyzers\dotnet\cs\ZeroAlloc.Specification.Generator.dll" />
  </ItemGroup>

</Project>
