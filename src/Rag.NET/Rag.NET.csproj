<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET</RootNamespace>
    <PackageId>Rag.NET</PackageId>
    <Description>Modular RAG pipeline library for .NET</Description>
    <!-- container: the pipeline is exercised against real pgvector in the gating Docker
         tier (Security.IntegrationTests) and against real Ollama plus pgvector in the
         nightly E2E suite, on top of Rag.NET.Tests. -->
    <VerifiedBy>container</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Lifts transitive SQLitePCLRaw.lib.e_sqlite3 above 2.1.11 (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Resilience" Version="10.*" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="0.*" />
    <!-- Not part of the Microsoft.NETCore.App shared framework (verified: absent from the
         net10.0 ref pack) — only reachable transitively via Polly today, so reference it
         explicitly for the token-bucket rate limiter. -->
    <PackageReference Include="System.Threading.RateLimiting" Version="10.*" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="0.*" />
    <PackageReference Include="ZeroAlloc.Inject" Version="1.7.1" />
    <PackageReference Include="ZeroAlloc.Results" Version="1.2.0" />
    <!-- Generators ship under analyzers/dotnet/cs and are auto-wired by the SDK;
         Validation.Generator bundles ZeroAlloc.Pipeline(.Generators), so no standalone
         Pipeline.Generators reference or explicit Analyzer items are needed. -->
    <PackageReference Include="ZeroAlloc.Inject.Generator" Version="1.7.1" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Specification 1.1.0 bundles its generator — a separate Specification.Generator
         reference would run the generator twice (duplicate And/Or/Not members). -->
    <PackageReference Include="ZeroAlloc.Specification" Version="1.1.0" />
    <PackageReference Include="ZeroAlloc.Validation" Version="1.5.3" />
    <PackageReference Include="ZeroAlloc.Validation.Generator" Version="1.5.3" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="ZeroAlloc.Pipeline" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.Abstractions\Rag.NET.Abstractions.csproj" />
    <ProjectReference Include="..\Rag.NET.QueryTechniques\Rag.NET.QueryTechniques.csproj" />
  </ItemGroup>


</Project>
