<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET</RootNamespace>
    <PackageId>Rag.NET</PackageId>
    <Description>Modular RAG pipeline library for .NET — ingestion and retrieval pipeline builders, self-query, corrective RAG and conversation memory</Description>
    <!-- container: the pipeline is exercised against real pgvector in the gating Docker
         tier (Security.IntegrationTests) and against real Ollama plus pgvector in the
         nightly E2E suite, on top of Rag.NET.Tests. -->
    <VerifiedBy>container</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <!-- The "Rag.NET"-named ActivitySource every instrumented satellite also links; see
         src/Shared/RagTelemetrySource.cs for why linking (one definition, no new dependency on
         either side) rather than a shared reference is the right shape here. -->
    <Compile Include="..\Shared\RagTelemetrySource.cs" Link="Telemetry\RagTelemetrySource.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- The Rag.NET.Resilience satellite's builder extensions decorate registrations via
         core's internal ServiceDecorationHelper (same contract, same error messages). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Resilience</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <!-- HybridCache (the abstract class the cache behaviours inject) is defined here, not in
         Microsoft.Extensions.Caching.Hybrid — that package carries the implementation and is
         referenced only by the Rag.NET.Caching satellite, whose UseCaching() registers it. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" />
    <PackageReference Include="ZeroAlloc.Inject" />
    <PackageReference Include="ZeroAlloc.Results" />
    <!-- Generators ship under analyzers/dotnet/cs and are auto-wired by the SDK;
         Validation.Generator bundles ZeroAlloc.Pipeline(.Generators), so no standalone
         Pipeline.Generators reference or explicit Analyzer items are needed. -->
    <PackageReference Include="ZeroAlloc.Inject.Generator" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Specification 1.1.0 bundles its generator — a separate Specification.Generator
         reference would run the generator twice (duplicate And/Or/Not members). -->
    <PackageReference Include="ZeroAlloc.Specification" />
    <PackageReference Include="ZeroAlloc.Validation" />
    <PackageReference Include="ZeroAlloc.Validation.Generator" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="ZeroAlloc.Pipeline" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.Abstractions\Rag.NET.Abstractions.csproj" />
    <ProjectReference Include="..\Rag.NET.QueryTechniques\Rag.NET.QueryTechniques.csproj" />
  </ItemGroup>


</Project>
