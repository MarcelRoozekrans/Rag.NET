{
  // Rag.NET.Cli (ragnet) sample configuration. Copy this next to the tool's working directory as
  // appsettings.json, replace every placeholder below, and delete the comments (or leave them —
  // the configuration loader tolerates them). Every value here can also be set as an environment
  // variable using "__" as the section separator, e.g. RagNet__ChatClient__ApiKey.
  "RagNet": {
    // The chat client. One OpenAI-compatible shape covers OpenAI, Azure OpenAI, OpenRouter,
    // Ollama, and LM Studio — they all speak the same wire API.
    "ChatClient": {
      "Endpoint": "https://api.openai.com/v1",
      "ApiKey": "REPLACE_WITH_YOUR_API_KEY",
      "Model": "gpt-4o-mini"
    },

    // The embedding generator. Same OpenAI-compatible shape as ChatClient. VectorDimensions is
    // the width the configured model actually produces — 1536 for OpenAI's
    // text-embedding-3-small, 768 for nomic-embed-text — and the vector store below must agree
    // with it. A local Ollama or LM Studio endpoint (http://localhost:11434/v1) may leave ApiKey
    // unset; any other endpoint requires a real key.
    "Embeddings": {
      "Endpoint": "https://api.openai.com/v1",
      "ApiKey": "REPLACE_WITH_YOUR_API_KEY",
      "Model": "text-embedding-3-small",
      "VectorDimensions": 1536
    },

    // The vector store. Kind selects exactly one of the three supported kinds below; only the
    // block matching Kind is read. Anything outside this set (Weaviate, Pinecone, Chroma, Azure
    // AI Search, ...) means hosting Rag.NET.Mcp or Rag.NET directly in your own application
    // instead of this tool — see the README.
    "VectorStore": {
      // "InMemory" is the default and needs no setup, but every ingested document is lost the
      // moment the process exits — a warning is logged at startup so this cannot go unnoticed.
      // Fine for a one-off `ragnet ingest`/`ragnet query` pair in the same shell session; set
      // Kind to "Qdrant" or "PgVector" for anything that must survive between runs.
      "Kind": "InMemory",

      // Read only when Kind is "Qdrant".
      "Qdrant": {
        "Host": "localhost",
        "Port": 6334,
        "CollectionName": "ragnet"
      },

      // Read only when Kind is "PgVector".
      "PgVector": {
        "ConnectionString": "Host=localhost;Database=ragnet;Username=REPLACE_ME;Password=REPLACE_ME"
      }
    }
  }
}
