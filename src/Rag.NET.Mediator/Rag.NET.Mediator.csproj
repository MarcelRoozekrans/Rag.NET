<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rag.NET.Mediator</RootNamespace>
    <PackageId>Rag.NET.Mediator</PackageId>
    <Description>ZeroAlloc.Mediator integration for Rag.NET</Description>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Suppress ZAM003: request types use class records because they carry Stream / IProgress
         references that cannot be stored in readonly record structs.
         Suppress EPC12: fires on the ZeroAlloc.Mediator 5.x GENERATED dispatch code
         (catch blocks that only read ex.Message for the activity status) — not our code.
         Confirmed still firing after the 4.1.4 -> 5.0.0 generator bump (2026-08). -->
    <NoWarn>ZAM003;EPC12</NoWarn>
    <VerifiedBy>unit</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZeroAlloc.Mediator" />
    <!-- Since 4.x the generator ships under analyzers/dotnet/cs (auto-wired by the SDK) and
         bundles its ZeroAlloc.Pipeline.Generators dependency — no explicit Analyzer items. -->
    <PackageReference Include="ZeroAlloc.Mediator.Generator" PrivateAssets="all" ExcludeAssets="runtime" />
    <ProjectReference Include="..\Rag.NET\Rag.NET.csproj" />
  </ItemGroup>
</Project>
