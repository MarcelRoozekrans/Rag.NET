<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.Memory</RootNamespace>
    <PackageId>Rag.NET.Memory</PackageId>
    <Description>Persistent SQLite-backed conversation memory for Rag.NET</Description>
    <PackageTags>$(PackageTags);conversation-memory;chat-history;sqlite</PackageTags>
    <!-- Milestone 6, Phase 6.2: an exchange stored into a real vector store and recalled by a FRESH instance over the same store (RealStoreRoundTripTests). -->
    <VerifiedBy>integration</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET\Rag.NET.csproj" />
  </ItemGroup>

</Project>
