<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.GraphRag</RootNamespace>
    <PackageId>Rag.NET.GraphRag</PackageId>
    <Description>GraphRAG — entity extraction, community detection, local + global search for Rag.NET</Description>
    <PackageTags>$(PackageTags);graphrag;knowledge-graph;entity-extraction</PackageTags>
    <!-- benchmark: extraction, community detection, local and global search run end to end
         over the whole MultiHop-RAG corpus with every model call replayed — nDCG pinned in
         BeirReproduction (GraphRag 0.56897, GraphRagDepthControl 0.63967) and answer accuracy in
         MultiHopRagAnswerReproduction (dense 0.3499, control 0.1384, local 0.2102, global
         0.5951). The runs that found eight shipping defects and #247. Milestone 6.0, 2026-08-15. -->
    <VerifiedBy>benchmark</VerifiedBy>
  </PropertyGroup>

  <ItemGroup>
    <!-- The "Rag.NET"-named ActivitySource core also links; see src/Shared/RagTelemetrySource.cs.
         Linked rather than reached through the ProjectReference to core below: every
         instrumented package gets its own instance of the same name, uniformly, regardless of
         whether it also happens to depend on core for other reasons. -->
    <Compile Include="..\Shared\RagTelemetrySource.cs" Link="Telemetry\RagTelemetrySource.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- ConvertRelationships and RelationshipWeightAudit are the seam issue #209's regression is
         asserted at. The defect was a scalar the LLM controls reaching the clusterer unchecked, so
         the test that pins it has to be able to hand that scalar in directly — including NaN, which
         no JSON number can express and which therefore cannot be reached through the behaviour's
         public surface at all. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.GraphRag.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET\Rag.NET.csproj" />
    <ProjectReference Include="..\Rag.NET.Graph\Rag.NET.Graph.csproj" />
    <!-- The runtime library flows transitively through Rag.NET, but the generator is
         PrivateAssets="all" there and analyzers do not flow — [Validate] on this package's
         options types emits nothing without a direct generator reference. -->
    <PackageReference Include="ZeroAlloc.Validation" />
    <PackageReference Include="ZeroAlloc.Validation.Generator" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
