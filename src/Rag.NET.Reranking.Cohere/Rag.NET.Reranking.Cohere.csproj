<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.Reranking.Cohere</RootNamespace>
    <PackageId>Rag.NET.Reranking.Cohere</PackageId>
    <Description>Cohere Rerank API integration for Rag.NET</Description>
    <VerifiedBy>unit</VerifiedBy>
    <VerifiedByReason>Cohere Rerank API. No account or credential for it exists on this project, so no scrubbed
      recording can be made; that is the blocker, and it is not effort. Coverage is unit tests over
      fakes and an SDK boundary; no HTTP exchange with the service is exercised at all. What stays
      unverified: request shape, authentication, pagination on real data, and error and rate-limit
      handling — everything the SDK does on the wire.</VerifiedByReason>
  </PropertyGroup>

  <ItemGroup>
    <!-- The "Rag.NET"-named ActivitySource core also links; see src/Shared/RagTelemetrySource.cs.
         Linked, not referenced: a ProjectReference to core would pull the whole pipeline into a
         reranker. -->
    <Compile Include="..\Shared\RagTelemetrySource.cs" Link="Telemetry\RagTelemetrySource.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.Abstractions\Rag.NET.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cohere" />
  </ItemGroup>

</Project>
