<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.Diagnostics</RootNamespace>
    <PackageId>Rag.NET.Diagnostics</PackageId>
    <Description>Disposable in-memory pipeline traces for Rag.NET: the last N query executions, with chunk scores, stage latencies and guard actions</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rag.NET.Diagnostics.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Deliberately no ProjectReference. Capture is five records, a ring buffer and a collector;
         it needs no part of the pipeline to describe what the pipeline did. Referencing
         Rag.NET.Security to reuse AuditChunkRef was measured and rejected: it takes the transitive
         closure from 15 packages to 41, pulling in SQLite and its native binaries, the ML
         tokenizers and their data file, Polly and protobuf. TraceChunk mirrors AuditChunkRef's
         field names instead, so the vocabulary is still shared. The behaviors and decorators that
         do need pipeline types are separate types and can carry the reference themselves. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
  </ItemGroup>

</Project>
