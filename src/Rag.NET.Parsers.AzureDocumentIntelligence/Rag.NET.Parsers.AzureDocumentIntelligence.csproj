<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Rag.NET.Parsers.AzureDocumentIntelligence</RootNamespace>
    <PackageId>Rag.NET.Parsers.AzureDocumentIntelligence</PackageId>
    <Description>Azure Document Intelligence document parser for Rag.NET: TIFF and HEIF scans, with opt-in PDF, image, Office and HTML formats</Description>
    <VerifiedBy>unit</VerifiedBy>
    <VerifiedByReason>Azure AI Document Intelligence. Its WireMock cassettes are HAND-WRITTEN from the
      documented response shape rather than recorded, so they verify the analyzer and the parser's
      section mapping against fixtures written alongside them. An env-gated live test,
      AzureDocumentIntelligenceParserLiveTests, sends a single-frame TIFF to a real resource, but it
      skips until the RAGNET_DOCINTEL_ENDPOINT and RAGNET_DOCINTEL_KEY repository secrets are
      provisioned, and they are not: nightly.yml maps them, and every run skips. Nothing in this
      package has yet run against the real service. Still owed: one live run with
      RAGNET_DOCINTEL_CAPTURE set, whose captured bodies replace the hand-written ones as a committed
      recorded cassette, the same capture the PDF OCR engine took in #354. Unverified until then: that
      the real service's response shape for TIFF, HEIF and Office input matches the fixtures, and
      that its error responses deserialise as the hand-written 401 does.</VerifiedByReason>
  </PropertyGroup>

  <!-- No reference to Rag.NET.Parsers.Pdf on purpose: a consumer that only wants TIFF scans
       must not have to install PdfPig. The dependency points the other way — the PDF OCR engine
       package references this one and delegates to its analyzer. -->
  <ItemGroup>
    <ProjectReference Include="..\Rag.NET.Abstractions\Rag.NET.Abstractions.csproj" />
    <PackageReference Include="Azure.AI.DocumentIntelligence" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
