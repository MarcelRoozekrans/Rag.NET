<Project>
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- Workaround for .NET 10 SDK 10.0.104 regression (tracked upstream):
         MSB3492 ("Could not read existing cache file") fires during the CLI's
         question-build pre-check. TreatWarningsAsErrors escalates it to an error,
         which causes the pre-check to exit non-zero and the CLI to abort instead
         of proceeding to compile. Demoting MSB3492 to a message lets the pre-check
         exit cleanly. NOTE: `dotnet test` from a completely empty obj/ still
         requires `dotnet build` first — a deeper CLI regression in the same SDK.
         Remove both this workaround and the note once the SDK bug is fixed. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3492</MSBuildWarningsAsMessages>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGetAudit as the ci-baseline nuget-audit job runs it, so a local restore shows the same
         advisories: every package, direct and transitive, from moderate severity up. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>

  <!-- Shared NuGet package metadata. Genuinely identical for every package.
       Description is deliberately NOT set here: a shared description would make
       74 packages describe themselves identically — each .csproj owns its own.
       PackageIcon is the brand mark's 128 px verdigris raster, assets/brand/icon-128.png, packed
       as icon.png by the item below — see docs/design/LOGO.md § Raster set. -->
  <PropertyGroup>
    <Authors>Marcel Roozekrans</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MarcelRoozekrans/Rag.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MarcelRoozekrans/Rag.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>rag;retrieval-augmented-generation;llm;ai;embeddings;vector-search;chunking;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- The PDB travels inside each DLL, not in a separate .snupkg. Visual Studio and Rider read an
         embedded PDB with no extra setting, whereas a .snupkg is only downloaded when the
         NuGet.org symbol server is enabled under Tools > Options > Debugging > Symbols, which is
         off by default — so F12 into this library showed decompiled code (#1030). The SDK's own
         Source Link (.NET 8+) still stamps the repository and commit into the PDB; only where the
         PDB lives changed. dotnet pack says nothing when a DLL has no PDB, so the guard is
         tests/Rag.NET.PackageValidation.Tests, not the SDK. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Deterministic build, CI only. It rewrites the source paths in the PDB to /_/ instead of
       /home/runner/work/..., so the packed binaries do not depend on the runner's directory layout.
       Not set locally: a local build keeps real paths so the debugger finds the working tree. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- PackageReadmeFile names the file inside the package; this packs each project's OWN
         README.md, sitting beside its .csproj. The repo-wide root README.md is deliberately
         not a fallback: a packable project without its own README fails pack (NU5039)
         instead of silently showing every nuget.org visitor the whole project —
         tests/Rag.NET.PackageValidation.Tests/PackageReadmeTests.cs guards what ships. -->
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" Visible="false" />
    <!-- PackageIcon names icon.png; this packs it. One icon for every package, unlike the README:
         the mark is the project's, not any one package's. -->
    <None Include="$(MSBuildThisFileDirectory)assets\brand\icon-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ErrorProne.NET.CoreAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ErrorProne.NET.Structs">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
