<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Workaround for .NET 10 SDK 10.0.104 regression (tracked upstream):
         MSB3492 ("Could not read existing cache file") fires during the CLI's
         question-build pre-check. TreatWarningsAsErrors escalates it to an error,
         which causes the pre-check to exit non-zero and the CLI to abort instead
         of proceeding to compile. Demoting MSB3492 to a message lets the pre-check
         exit cleanly. NOTE: `dotnet test` from a completely empty obj/ still
         requires `dotnet build` first — a deeper CLI regression in the same SDK.
         Remove both this workaround and the note once the SDK bug is fixed. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3492</MSBuildWarningsAsMessages>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Shared NuGet package metadata. Genuinely identical for every package.
       Description is deliberately NOT set here: a shared description would make
       66 packages describe themselves identically — each .csproj owns its own.
       No PackageIcon: the repository has no icon asset. -->
  <PropertyGroup>
    <Authors>Marcel Roozekrans</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MarcelRoozekrans/Rag.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MarcelRoozekrans/Rag.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>rag;retrieval-augmented-generation;llm;ai;embeddings;vector-search;chunking;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Symbol packages, one .snupkg beside every .nupkg. dotnet pack says nothing when these are
         absent — the symbol package simply never exists — so the guard is
         tests/Rag.NET.PackageValidation.Tests, not the SDK. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- PackageReadmeFile names the file inside the package; this packs each project's OWN
         README.md, sitting beside its .csproj. The repo-wide root README.md is deliberately
         not a fallback: a packable project without its own README fails pack (NU5039)
         instead of silently showing every nuget.org visitor the whole project —
         tests/Rag.NET.PackageValidation.Tests/PackageReadmeTests.cs guards what ships. -->
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ErrorProne.NET.CoreAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ErrorProne.NET.Structs">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NetFabric.Hyperlinq.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ZeroAlloc.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
